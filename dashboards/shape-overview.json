{
  "title": "LLM workload shape",
  "uid": "llm-shape-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "llm-shape-proxy"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(llm_shape_requests_total, route)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(llm_shape_requests_total{route=~\"$route\"}, model)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(llm_shape_requests_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "In flight (all instances)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (route) (llm_shape_inflight{route=~\"$route\"})",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Concurrency at arrival (per instance)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_shape_concurrency_at_arrival_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(llm_shape_concurrency_at_arrival_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_shape_concurrency_at_arrival_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Requests already in flight on the route when a request arrived, on the instance that served it. Exact cross-instance concurrency comes from JSONL records."
    },
    {
      "type": "row",
      "title": "Size",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 5
    },
    {
      "type": "heatmap",
      "title": "Prompt tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(llm_shape_prompt_tokens_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short"
        }
      }
    },
    {
      "type": "heatmap",
      "title": "Completion tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(llm_shape_completion_tokens_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "short"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Input / output token ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum(rate(llm_shape_prompt_tokens_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval])) / sum(rate(llm_shape_completion_tokens_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "input/output",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Shape cells: share of requests by prompt \u00d7 output tokens (bucket upper bounds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (prompt_bucket, output_bucket) (increase(llm_shape_cell_total{route=~\"$route\",model=~\"$model\"}[$__range])) / scalar(sum(increase(llm_shape_cell_total{route=~\"$route\",model=~\"$model\"}[$__range])))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Rows: prompt token bucket. Columns: output token bucket. Reported and estimated usage together.",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "prompt_bucket",
            "columnField": "output_bucket",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Time to first token",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_shape_ttft_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(llm_shape_ttft_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_shape_ttft_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_shape_latency_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(llm_shape_latency_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_shape_latency_seconds_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Decode rate, median",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_shape_decode_tokens_per_second_bucket{route=~\"$route\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "p50 tokens/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Reuse",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Upstream prefix cache hit share",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum(rate(llm_shape_cached_prompt_tokens_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval])) / sum(rate(llm_shape_prompt_tokens_total{route=~\"$route\",model=~\"$model\",usage=\"reported\"}[$__rate_interval]))",
          "legendFormat": "cached / input",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Only where the upstream reports cached tokens."
    },
    {
      "type": "timeseries",
      "title": "Usage source share",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (usage) (rate(llm_shape_completion_tokens_count{route=~\"$route\",model=~\"$model\"}[$__rate_interval])) / ignoring(usage) group_left sum(rate(llm_shape_completion_tokens_count{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{usage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Reported by the upstream vs estimated by the proxy."
    },
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (status_class, outcome) (rate(llm_shape_requests_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Without usage (neither reported nor estimated)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum(rate(llm_shape_usage_missing_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval])) / sum(rate(llm_shape_requests_total{route=~\"$route\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "share",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Proxy internals",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum(rate(llm_shape_events_dropped_total[$__rate_interval]))",
          "legendFormat": "events dropped/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(llm_shape_event_queue_length)",
          "legendFormat": "queue length",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "sum(rate(llm_shape_stage2_panics_total[$__rate_interval]))",
          "legendFormat": "stage-2 panics/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        },
        {
          "expr": "sum by (state) (rate(llm_shape_capture_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "capture {{state}}/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Capture memory in use",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 21,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "expr": "sum(llm_shape_capture_budget_used_bytes)",
          "legendFormat": "bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Authentication failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 22,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(llm_shape_auth_failures_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
